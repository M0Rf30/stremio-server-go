# rivulet-engine environment configuration
# Full reference: https://github.com/rivulet-kodi/rivulet-engine/blob/main/docs/CONFIGURATION.md
#
# Installed to /etc/rivulet-engine/rivulet-engine.env and read by the systemd
# user unit. Per-user overrides go in ~/.config/rivulet-engine/env (read after
# this file, so its values win). Commented keys show the built-in default.
# systemd does NOT expand %h or $HOME here: use absolute paths.

# --- Network / ports ---
# The API is unauthenticated. Loopback is all the Stremio desktop/web client
# needs; set to 0.0.0.0 / :: (or a LAN IP) only for LAN casting or other devices.
BIND_ADDRESS=127.0.0.1
#HTTP_PORT=11470
#HTTPS_PORT=12470
#BT_LISTEN_PORT=0
#WEB_UI_LOCATION=https://web.stremio.com/
# Public base URL behind a TLS-terminating reverse proxy (also the fallback for
# RIVULET_PROXY_PUBLIC_URL).
#RIVULET_PUBLIC_URL=

# --- Browser access control ---
# Extra origins allowed to call the API (comma-separated; *.domain wildcards).
# Built-in: Stremio web apps, *.stremio.rocks, localhost, the server's own IPs,
# and requests with no Origin (native players). "*" restores open legacy CORS.
#RIVULET_ALLOWED_ORIGINS=
# Extra Host header names accepted on non-media routes (DNS-rebinding guard).
#RIVULET_ALLOWED_HOSTS=
# CIDRs/IPs of reverse proxies whose X-Forwarded-* headers are honoured
# (loopback always is).
#RIVULET_TRUSTED_PROXIES=

# --- Storage / cache ---
#APP_PATH=/home/<user>/.rivulet-engine
#RIVULET_MEMORY_CACHE_SIZE=0
#RIVULET_MEM_LIMIT=
#RIVULET_TORRENT_IDLE_TIMEOUT=300
# Max simultaneously active torrent engines (<=0 disables the cap).
#RIVULET_MAX_ENGINES=20
# Seconds (or a Go duration) /create waits for torrent metadata before 504.
#RIVULET_CREATE_METADATA_TIMEOUT=90
# Disk piece cache I/O backend: classic (pread/pwrite) or mmap.
#TORRENT_STORAGE_DEFAULT_FILE_IO=classic

# --- Local files add-on / local archives ---
#LOCAL_FILES_DIR=
#RIVULET_LOCAL_IMDB=on
#RIVULET_ARCHIVE_LOCAL_ROOT=
# Externally reachable base URL of this server, served to remote Stremio
# clients (enables /local-addon/file/<hash> instead of file:// URLs).
#RIVULET_LOCAL_FILES_PUBLIC_URL=

# --- SSRF guards (private/LAN targets blocked by default) ---
#RIVULET_ARCHIVE_ALLOW_PRIVATE=
#RIVULET_FTP_ALLOW_PRIVATE=
# /proxy and /extractor private destinations are blocked by default
# (cloud-metadata is always blocked). A proxy password or IP ACL always
# re-enables blocking; use _PRIVATE_ALLOW to reach specific LAN hosts (IPs,
# CIDRs, hostnames; comma-separated) even from a protected server.
#RIVULET_PROXY_ALLOW_PRIVATE=
#RIVULET_PROXY_PRIVATE_ALLOW=

# --- Transcoding ---
#RIVULET_HWACCEL=
# Idle HLS transcode session TTL (seconds or a Go duration; 0 = never evict),
# cap on concurrent sessions, and working/persistence options.
#RIVULET_HLS_SESSION_TTL=60
#RIVULET_HLS_REAPER_INTERVAL=
#RIVULET_HLS_MAX_SESSIONS=64
#RIVULET_HLS_NEG_PROBE_TTL=300
#RIVULET_HLS_POS_PROBE_TTL=600
#RIVULET_HLS_SESSION_OVERRIDES=
#RIVULET_HLS_WORK_DIR=
#RIVULET_HLS_PERSIST=
#RIVULET_HLS_SEGMENT_CACHE_BYTES=
#RIVULET_HLS_VAAPI_DEVICE=/dev/dri/renderD128
#RIVULET_HLS_SEGMENT_TIMEOUT=120
#RIVULET_HLS_SUBTITLE_TIMEOUT=120
#RIVULET_HLS_PROBE_TIMEOUT=30
#RIVULET_HLS_SEEK_PREROLL=10
# Encoder settings (ffmpeg syntax). MAX_WIDTH/HEIGHT 0 = no downscale;
# CONCURRENCY defaults to the number of CPUs; TONEMAP=off|on|mobius|hable|...
#RIVULET_TRANSCODE_VIDEO_BITRATE=8M
#RIVULET_TRANSCODE_MAXRATE=8M
#RIVULET_TRANSCODE_BUFSIZE=16M
#RIVULET_TRANSCODE_MAX_WIDTH=0
#RIVULET_TRANSCODE_MAX_HEIGHT=0
#RIVULET_TRANSCODE_VAAPI_QP=23
#RIVULET_TRANSCODE_NVENC_PRESET=p4
#RIVULET_TRANSCODE_QSV_PRESET=veryfast
#RIVULET_TRANSCODE_X264_PRESET=veryfast
#RIVULET_TRANSCODE_X264_CRF=23
#RIVULET_TRANSCODE_TONEMAP=off
#RIVULET_TRANSCODE_AUDIO_CHANNELS=2
#RIVULET_TRANSCODE_AUDIO_BITRATE=192k
#RIVULET_TRANSCODE_CONCURRENCY=

# --- Logging / diagnostics ---
#RIVULET_LOG_LEVEL=info
#RIVULET_LOG_FORMAT=text
#RIVULET_HTTP_LOG=
#RIVULET_PPROF=

# --- Stream proxy (/proxy) ---
#RIVULET_PROXY_PASSWORD=
#RIVULET_PROXY_SECRET=
#RIVULET_PROXY_IP_ACL=
#RIVULET_PROXY_PREBUFFER=3
#RIVULET_PROXY_SEG_CACHE_TTL=300
#RIVULET_PROXY_PUBLIC_URL=
#RIVULET_PROXY_UPSTREAM=

# --- DVR recording (/record, /api/recordings; EasyProxy compatible) ---
# Opt-in. Records streams in the background with ffmpeg (stream copy, MPEG-TS)
# while the player watches live. Strongly recommended together with
# RIVULET_PROXY_PASSWORD (required as api_password on every DVR route); with an
# IP ACL include 127.0.0.1, the recorder reads the proxy on loopback.
#RIVULET_DVR_ENABLED=
#RIVULET_DVR_DIR=
# Seconds (or a Go duration): length when a request has no duration, and the
# hard per-recording cap (longer requests are clamped).
#RIVULET_DVR_DEFAULT_DURATION=14400
#RIVULET_DVR_MAX_DURATION=28800
# Concurrent recordings (more get 429); total size cap of the recordings
# directory in bytes (0 = unlimited); age out finished recordings (0 = keep).
#RIVULET_DVR_MAX_ACTIVE=2
#RIVULET_DVR_MAX_BYTES=0
#RIVULET_DVR_RETENTION_DAYS=7

# --- Indexer add-ons ---
#RIVULET_BITMAGNET_URL=
#RIVULET_TORZNAB_URL=
#RIVULET_TORZNAB_APIKEY=
#RIVULET_METADATA_URL=https://v3-cinemeta.strem.io

# --- Casting ---
#RIVULET_ENABLE_DLNA=

# --- HTTPS cert provisioning (keep the authKey in the per-user file) ---
#RIVULET_CERT_AUTHKEY=
#RIVULET_CERT_IP=

# --- BitTorrent engine ---
#RIVULET_PEERS_PER_TORRENT=0
#RIVULET_DISABLE_WEBTORRENT=on
#RIVULET_DISABLE_TRACKERS=
#RIVULET_TRACKERS_URL=
#RIVULET_TRACKERS_MAX=5
#RIVULET_MAX_SEED_RATIO=0

# --- Censorship resistance (see README "Censorship resistance") ---
#RIVULET_BT_ENCRYPTION=prefer
#RIVULET_BT_PROXY=
#RIVULET_DHT_BOOTSTRAP=
#RIVULET_BT_ANONYMOUS=

# --- Extractors (/extractor, embed resolution) ---
# The server ships no host definitions. They come from $APP_PATH/extractors.json
# (or RIVULET_EXTRACTORS_FILE) and/or a signed remote list. The remote list is
# used only when RIVULET_EXTRACTORS_PUBKEY is set and <URL>.sig verifies.
# Uncomment and fill in both URL and PUBKEY to opt in to a remote list:
#RIVULET_EXTRACTORS_FILE=
#RIVULET_EXTRACTORS_URL=
#RIVULET_EXTRACTORS_PUBKEY=
