# stremio-server-go environment configuration
# Full reference: https://github.com/M0Rf30/stremio-server-go#environment
#
# Installed to /etc/stremio-server/stremio-server.env and read by the systemd
# user unit. Per-user overrides go in ~/.config/stremio-server/env (read after
# this file, so its values win). Commented keys show the built-in default.
# systemd does NOT expand %h or $HOME here: use absolute paths.

# --- Network / ports ---
# The API is unauthenticated. Loopback is all the Stremio desktop/web client
# needs; set to 0.0.0.0 / :: (or a LAN IP) only for LAN casting or other devices.
BIND_ADDRESS=127.0.0.1
#HTTP_PORT=11470
#HTTPS_PORT=12470
#BT_LISTEN_PORT=0
#WEB_UI_LOCATION=https://web.stremio.com/

# --- Browser access control ---
# Extra origins allowed to call the API (comma-separated; *.domain wildcards).
# Built-in: Stremio web apps, *.stremio.rocks, localhost, the server's own IPs,
# and requests with no Origin (native players). "*" restores open legacy CORS.
#STREMIO_ALLOWED_ORIGINS=

# --- Storage / cache ---
#APP_PATH=/home/<user>/.stremio-server
#STREMIO_MEMORY_CACHE_SIZE=0
#STREMIO_MEM_LIMIT=
#STREMIO_TORRENT_IDLE_TIMEOUT=300

# --- Local files add-on / local archives ---
#LOCAL_FILES_DIR=
#STREMIO_LOCAL_IMDB=on
#STREMIO_ARCHIVE_LOCAL_ROOT=

# --- SSRF guards (private/LAN targets blocked by default) ---
#STREMIO_ARCHIVE_ALLOW_PRIVATE=
#STREMIO_FTP_ALLOW_PRIVATE=

# --- Transcoding ---
#STREMIO_HWACCEL=

# --- Logging / diagnostics ---
#STREMIO_LOG_LEVEL=info
#STREMIO_LOG_FORMAT=text
#STREMIO_HTTP_LOG=
#STREMIO_PPROF=

# --- Stream proxy (/proxy) ---
#STREMIO_PROXY_PASSWORD=
#STREMIO_PROXY_SECRET=
#STREMIO_PROXY_IP_ACL=
#STREMIO_PROXY_PREBUFFER=3
#STREMIO_PROXY_SEG_CACHE_TTL=300
#STREMIO_PROXY_PUBLIC_URL=
#STREMIO_PROXY_UPSTREAM=

# --- Indexer add-ons ---
#STREMIO_BITMAGNET_URL=
#STREMIO_TORZNAB_URL=
#STREMIO_TORZNAB_APIKEY=
#STREMIO_METADATA_URL=https://v3-cinemeta.strem.io

# --- Casting ---
#STREMIO_ENABLE_DLNA=

# --- HTTPS cert provisioning (keep the authKey in the per-user file) ---
#STREMIO_CERT_AUTHKEY=
#STREMIO_CERT_IP=

# --- BitTorrent engine ---
#STREMIO_PEERS_PER_TORRENT=0
#STREMIO_DISABLE_WEBTORRENT=on
#STREMIO_DISABLE_TRACKERS=
#STREMIO_TRACKERS_URL=
#STREMIO_TRACKERS_MAX=5
#STREMIO_MAX_SEED_RATIO=0

# --- Censorship resistance (see README "Censorship resistance") ---
#STREMIO_BT_ENCRYPTION=prefer
#STREMIO_BT_PROXY=
#STREMIO_DHT_BOOTSTRAP=
#STREMIO_BT_ANONYMOUS=
