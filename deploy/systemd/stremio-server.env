# stremio-server-go environment configuration
# Full reference: https://github.com/M0Rf30/stremio-server-go#environment
#
# Installed to /etc/stremio-server/stremio-server.env and read by the systemd
# user unit. Per-user overrides go in ~/.config/stremio-server/env (read after
# this file, so its values win). Commented keys show the built-in default.
# systemd does NOT expand %h or $HOME here: use absolute paths.

# --- Network / ports ---
# The API is unauthenticated. Loopback is all the Stremio desktop/web client
# needs; set to 0.0.0.0 / :: (or a LAN IP) only for LAN casting or other devices.
BIND_ADDRESS=127.0.0.1
#HTTP_PORT=11470
#HTTPS_PORT=12470
#BT_LISTEN_PORT=0
#WEB_UI_LOCATION=https://web.stremio.com/
# Public base URL behind a TLS-terminating reverse proxy (also the fallback for
# STREMIO_PROXY_PUBLIC_URL).
#STREMIO_PUBLIC_URL=

# --- Browser access control ---
# Extra origins allowed to call the API (comma-separated; *.domain wildcards).
# Built-in: Stremio web apps, *.stremio.rocks, localhost, the server's own IPs,
# and requests with no Origin (native players). "*" restores open legacy CORS.
#STREMIO_ALLOWED_ORIGINS=
# Extra Host header names accepted on non-media routes (DNS-rebinding guard).
#STREMIO_ALLOWED_HOSTS=
# CIDRs/IPs of reverse proxies whose X-Forwarded-* headers are honoured
# (loopback always is).
#STREMIO_TRUSTED_PROXIES=

# --- Storage / cache ---
#APP_PATH=/home/<user>/.stremio-server
#STREMIO_MEMORY_CACHE_SIZE=0
#STREMIO_MEM_LIMIT=
#STREMIO_TORRENT_IDLE_TIMEOUT=300
# Max simultaneously active torrent engines (<=0 disables the cap).
#STREMIO_MAX_ENGINES=20
# Seconds (or a Go duration) /create waits for torrent metadata before 504.
#STREMIO_CREATE_METADATA_TIMEOUT=90
# Disk piece cache I/O backend: classic (pread/pwrite) or mmap.
#TORRENT_STORAGE_DEFAULT_FILE_IO=classic

# --- Local files add-on / local archives ---
#LOCAL_FILES_DIR=
#STREMIO_LOCAL_IMDB=on
#STREMIO_ARCHIVE_LOCAL_ROOT=
# Externally reachable base URL of this server, served to remote Stremio
# clients (enables /local-addon/file/<hash> instead of file:// URLs).
#STREMIO_LOCAL_FILES_PUBLIC_URL=

# --- SSRF guards (private/LAN targets blocked by default) ---
#STREMIO_ARCHIVE_ALLOW_PRIVATE=
#STREMIO_FTP_ALLOW_PRIVATE=
# /proxy and /extractor private destinations are blocked by default
# (cloud-metadata is always blocked). A proxy password or IP ACL always
# re-enables blocking; use _PRIVATE_ALLOW to reach specific LAN hosts (IPs,
# CIDRs, hostnames; comma-separated) even from a protected server.
#STREMIO_PROXY_ALLOW_PRIVATE=
#STREMIO_PROXY_PRIVATE_ALLOW=

# --- Transcoding ---
#STREMIO_HWACCEL=
# Idle HLS transcode session TTL (seconds or a Go duration; 0 = never evict),
# cap on concurrent sessions, and working/persistence options.
#STREMIO_HLS_SESSION_TTL=60
#STREMIO_HLS_REAPER_INTERVAL=
#STREMIO_HLS_MAX_SESSIONS=64
#STREMIO_HLS_NEG_PROBE_TTL=300
#STREMIO_HLS_POS_PROBE_TTL=600
#STREMIO_HLS_SESSION_OVERRIDES=
#STREMIO_HLS_WORK_DIR=
#STREMIO_HLS_PERSIST=
#STREMIO_HLS_SEGMENT_CACHE_BYTES=
#STREMIO_HLS_VAAPI_DEVICE=/dev/dri/renderD128
#STREMIO_HLS_SEGMENT_TIMEOUT=120
#STREMIO_HLS_SUBTITLE_TIMEOUT=120
#STREMIO_HLS_PROBE_TIMEOUT=30
#STREMIO_HLS_SEEK_PREROLL=10
# Encoder settings (ffmpeg syntax). MAX_WIDTH/HEIGHT 0 = no downscale;
# CONCURRENCY defaults to the number of CPUs; TONEMAP=off|on|mobius|hable|...
#STREMIO_TRANSCODE_VIDEO_BITRATE=8M
#STREMIO_TRANSCODE_MAXRATE=8M
#STREMIO_TRANSCODE_BUFSIZE=16M
#STREMIO_TRANSCODE_MAX_WIDTH=0
#STREMIO_TRANSCODE_MAX_HEIGHT=0
#STREMIO_TRANSCODE_VAAPI_QP=23
#STREMIO_TRANSCODE_NVENC_PRESET=p4
#STREMIO_TRANSCODE_QSV_PRESET=veryfast
#STREMIO_TRANSCODE_X264_PRESET=veryfast
#STREMIO_TRANSCODE_X264_CRF=23
#STREMIO_TRANSCODE_TONEMAP=off
#STREMIO_TRANSCODE_AUDIO_CHANNELS=2
#STREMIO_TRANSCODE_AUDIO_BITRATE=192k
#STREMIO_TRANSCODE_CONCURRENCY=

# --- Logging / diagnostics ---
#STREMIO_LOG_LEVEL=info
#STREMIO_LOG_FORMAT=text
#STREMIO_HTTP_LOG=
#STREMIO_PPROF=

# --- Stream proxy (/proxy) ---
#STREMIO_PROXY_PASSWORD=
#STREMIO_PROXY_SECRET=
#STREMIO_PROXY_IP_ACL=
#STREMIO_PROXY_PREBUFFER=3
#STREMIO_PROXY_SEG_CACHE_TTL=300
#STREMIO_PROXY_PUBLIC_URL=
#STREMIO_PROXY_UPSTREAM=

# --- DVR recording (/record, /api/recordings; EasyProxy compatible) ---
# Opt-in. Records streams in the background with ffmpeg (stream copy, MPEG-TS)
# while the player watches live. Strongly recommended together with
# STREMIO_PROXY_PASSWORD (required as api_password on every DVR route); with an
# IP ACL include 127.0.0.1, the recorder reads the proxy on loopback.
#STREMIO_DVR_ENABLED=
#STREMIO_DVR_DIR=
# Seconds (or a Go duration): length when a request has no duration, and the
# hard per-recording cap (longer requests are clamped).
#STREMIO_DVR_DEFAULT_DURATION=14400
#STREMIO_DVR_MAX_DURATION=28800
# Concurrent recordings (more get 429); total size cap of the recordings
# directory in bytes (0 = unlimited); age out finished recordings (0 = keep).
#STREMIO_DVR_MAX_ACTIVE=2
#STREMIO_DVR_MAX_BYTES=0
#STREMIO_DVR_RETENTION_DAYS=7

# --- Indexer add-ons ---
#STREMIO_BITMAGNET_URL=
#STREMIO_TORZNAB_URL=
#STREMIO_TORZNAB_APIKEY=
#STREMIO_METADATA_URL=https://v3-cinemeta.strem.io

# --- Casting ---
#STREMIO_ENABLE_DLNA=

# --- HTTPS cert provisioning (keep the authKey in the per-user file) ---
#STREMIO_CERT_AUTHKEY=
#STREMIO_CERT_IP=

# --- BitTorrent engine ---
#STREMIO_PEERS_PER_TORRENT=0
#STREMIO_DISABLE_WEBTORRENT=on
#STREMIO_DISABLE_TRACKERS=
#STREMIO_TRACKERS_URL=
#STREMIO_TRACKERS_MAX=5
#STREMIO_MAX_SEED_RATIO=0

# --- Censorship resistance (see README "Censorship resistance") ---
#STREMIO_BT_ENCRYPTION=prefer
#STREMIO_BT_PROXY=
#STREMIO_DHT_BOOTSTRAP=
#STREMIO_BT_ANONYMOUS=

# --- Extractors (/extractor, embed resolution) ---
# The server ships no host definitions. They come from $APP_PATH/extractors.json
# (or STREMIO_EXTRACTORS_FILE) and/or a signed remote list. The remote list is
# used only when STREMIO_EXTRACTORS_PUBKEY is set and <URL>.sig verifies.
# Uncomment and fill in both URL and PUBKEY to opt in to a remote list:
#STREMIO_EXTRACTORS_FILE=
#STREMIO_EXTRACTORS_URL=
#STREMIO_EXTRACTORS_PUBKEY=
